{
  "name": "pose-search-local-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/index.js",
    "dev": "npm rebuild better-sqlite3 && concurrently \"npx tsc --watch\" \"nodemon -q dist/index.js\"",
    "pack": "npm rebuild better-sqlite3 --target=18.18.0 && pkg --config pkg.config.json --output dist/PoseSearch.exe dist/index.js"
  },
  "pkg": {
    "assets":[
      "public/**/*",
      "node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    ]
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "body-parser": "^1.20.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.17.3",
    "multiparty": "^4.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.13",
    "@types/multiparty": "^0.0.33",
    "@types/node": "^17.0.24",
    "concurrently": "^7.1.0",
    "nexe": "^4.0.0-beta.19",
    "nodemon": "^2.0.15",
    "pkg": "^5.8.1",
    "typescript": "^4.6.3"
  }
}